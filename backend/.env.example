# ===== Server =====
PORT=5000
NODE_ENV=development
# Cho phep frontend goi API (nhieu origin cach nhau dau phay)
CORS_ORIGIN=http://localhost:5173

# ===== SQL Server =====
# Dung SQL Server Authentication (user/password). Xem README muc "Ket noi SQL Server".
DB_SERVER=localhost
DB_PORT=1433
# Neu dung named instance (vd: SQLEXPRESS) thi dien DB_INSTANCE va bo trong DB_PORT
DB_INSTANCE=
DB_DATABASE=PublicTransportDBV2
DB_USER=sa
DB_PASSWORD=your_password
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# ===== JWT =====
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ===== QR ticket =====
# Khoa ky so noi dung QR (chong lam gia ve)
QR_SECRET=change_this_qr_secret

# ===== AI (Google Gemini) - dat KHOA THAT trong .env.local (khong dua len GitHub) =====
# Lay khoa tai https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3-flash-preview,gemini-3.6-flash,gemini-3.5-flash-lite,gemini-flash-latest,gemini-3.8-flash
# GEMINI_EMBED_MODEL=gemini-embedding-001
# GEMINI_TIMEOUT_MS=25000
# GEMINI_THINKING_LEVEL=low
# GEOCODER=nominatim
